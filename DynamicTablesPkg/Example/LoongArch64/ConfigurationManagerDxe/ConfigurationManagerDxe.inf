[Defines]
  INF_VERSION                    = 0x0001001B
  BASE_NAME                      = LoongArch64MadtConfigurationManagerDxe
  FILE_GUID                      = 81547118-35A5-41C8-A4B5-A1EB29B31BD7
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = LoongArch64MadtConfigurationManagerDxeInitialize

#
# The following information is for reference only and not required by the build
# tools.
#
#  VALID_ARCHITECTURES           = LOONGARCH64
#

[Sources]
  ConfigurationManager.c
  ConfigurationManager.h
  PlatformMadtData.c

[Packages]
  DynamicTablesPkg/DynamicTablesPkg.dec
  MdePkg/MdePkg.dec

[LibraryClasses]
  DebugLib
  MemoryAllocationLib
  UefiBootServicesTableLib
  UefiDriverEntryPoint

[Protocols]
  gEdkiiConfigurationManagerProtocolGuid  ## PRODUCES
  gEfiMpServiceProtocolGuid                ## CONSUMES

[Depex]
  gEfiMpServiceProtocolGuid
